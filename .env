# Создайте копию этого файла с именем .env.local и переопределите необходимые переменные

# Хост, на котором разрешено открывать панель счетчика
VITE_JIRA_HOST=example.com

# Типы задач через запятую, которые будут игнорироваться при подсчете сторипоинтов
VITE_JIRA_TASK_IGNORE_TYPES=Retro AI,Sprint Goal

# Количество сторипоинтов на разработчика для цветовой индикации, отобразит
# < NORMAL серым
# >= NORMAL < TOO_MUCH зеленым
# >= TOO_MUCH < WAY_TOO_MUCH оранжевым
# > WAY_TOO_MUCH красным
VITE_JIRA_SP_NORMAL=11
VITE_JIRA_SP_TOO_MUCH=14
VITE_JIRA_SP_WAY_TOO_MUCH=17

# Регулярное выражение с шаблоном сторипоинтов в заголовках задач.
# Каждая группа должна обязательно быть именована, имена групп используются в верстке!
VITE_JIRA_SP_REGEXP=^\s*\[\s*(?:(?<be>\d+)\D+(?<fe>\d+)\D+(?<qa>\d+)|(?<rnd>\d+))\s*\]

# Разрешенные сочетания сторипоинтов у одного разработчика по группам.
# Группы пишутся через запятую, сочетания разделяются вертикальной чертой. Без пробелов.
# Имена групп должны соответствовать именам в регулярном выражении.
# Если поле не пустое, то должны быть перечислены все возможные сочетания!
# Например qa|fe,be разрешает fe и be, но запрещает qa и fe или qa и be сторипоинты
# у одного разработчика.
VITE_JIRA_SP_MIXINS=be|fe|qa|rnd|rnd,qa|rnd,fe,be